# Siloed guest mailbox (mode 0600 on the Hermes box). Never store these on WordPress.
GUESTCHAT_EMAIL=
GUESTCHAT_IMAP_HOST=
GUESTCHAT_IMAP_PORT=993
GUESTCHAT_SMTP_HOST=
GUESTCHAT_SMTP_PORT=465
GUESTCHAT_PASSWORD=

# WordPress poller user (mode 0600). Application password, not the human login.
WP_USER=
WP_APP_PASSWORD=
WP_INBOX_URL=https://example.com/wp-json/oda-chat/v1/inbox
WP_REPLY_URL=https://example.com/wp-json/oda-chat/v1/reply
